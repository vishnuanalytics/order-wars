# Backend API base URL (backend/main.py). Defaults to http://localhost:8000
# if unset — only needed if the backend runs somewhere else.
VITE_API_BASE_URL=http://localhost:8000

# Google Sign-In (src/auth.js) — the OAuth 2.0 Client ID from your Google
# Cloud Console (same value as the backend's GOOGLE_CLIENT_ID in the root
# .env.example). Not secret — Client IDs are meant to be public, that's why
# this is a VITE_-prefixed var Vite bakes into the built frontend JS. Leave
# unset to run with no sign-in at all; nothing else in the app requires it.
VITE_GOOGLE_CLIENT_ID=
