# LLM providers, tried in this order (agents/llm.py):
#   1. Groq        — free tier, tried first
#   2. OpenRouter   — free tier, tried second
#   3. Anthropic Claude — paid, last resort
# Set at least one. Unset keys are skipped, not errors.
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (defaults are set in agents/llm.py)
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# ANTHROPIC_MODEL=claude-sonnet-5

# Persistence (Neon Postgres) — see CLAUDE.md "Persistence (Neon Postgres)".
# NEON_API_KEY manages Neon *projects* (create/list/branch) — it is not a
# database connection string and db/session.py never reads it.
# DATABASE_URL is the actual Postgres connection string (from the Neon
# console: Dashboard -> Connect), needed by db/session.py and Alembic. It can
# point at a database shared with unrelated projects — every Order Wars
# table lives under the "order_wars" Postgres schema (db/session.py's
# DB_SCHEMA, applied via schema_translate_map), not `public`, so nothing
# else in that database is touched. Wired in as of Phase 5; before that, the
# models in db/models.py and the Alembic setup in db/migrations/ worked
# without it (tests use in-memory SQLite instead, still true today).
NEON_API_KEY=
DATABASE_URL=

# backend/main.py (FastAPI). Comma-separated allowed origins for the future
# browser frontend's cross-origin requests — defaults to "*" (any origin) if
# unset, which stays safe even with Google Sign-In (see backend/main.py's
# CORS comment: auth here is Bearer-token, not cookie-based). Set this once
# a specific frontend origin is known, e.g. CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=

# Google Sign-In (backend/auth.py) — optional everywhere it's used; the app
# runs fine with neither of these set, just with no sign-in available.
# GOOGLE_CLIENT_ID is the OAuth 2.0 Client ID from your Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID -> Web application) —
# not secret, also needed by frontend/.env's VITE_GOOGLE_CLIENT_ID (same
# value, both places). SESSION_SECRET signs this app's own session tokens
# after a Google sign-in — generate a real one, don't leave this blank if
# you're actually turning sign-in on:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_CLIENT_ID=
SESSION_SECRET=
